# Copy to .env in the project root. Never commit the filled .env file.
SEPOLIA_RPC_URL=https://your-sepolia-rpc-provider.example/v2/YOUR_API_KEY
BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-rpc-provider.example/v2/YOUR_API_KEY

# Set these to local file paths; keep the private keys inside those files.
DEPLOYER_PRIVATE_KEY_FILE=C:\secrets\guardian-deployer.key
AGENT_PRIVATE_KEY_FILE=C:\secrets\guardian-agent.key
TESTNET_RELAYER_PRIVATE_KEY_FILE=C:\secrets\guardian-testnet-relayer.key

# Needed only when running the backend testnet submission flow after deployment.
CHAIN_ID=11155111
ONCHAIN_RPC_URL=https://your-sepolia-rpc-provider.example/v2/YOUR_API_KEY
TESTNET_SUBMISSIONS_ENABLED=false
