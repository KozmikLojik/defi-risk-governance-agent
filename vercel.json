{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/frontend/dashboard.html" }
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{node_modules/**,contracts/**,backend/data/**,**/__pycache__/**}"
    }
  }
}
