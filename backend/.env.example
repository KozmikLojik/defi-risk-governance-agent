# Local development only. Replace all credentials before using a deployed environment.
ENVIRONMENT=development
AUTH_REQUIRED=false
AUTH_API_KEYS={}
RATE_LIMIT_READS_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=12
REDIS_URL=redis://localhost:6379/0
STARTING_CAPITAL=10000
AGENT_MODE=MANUAL
AGENT_INTERVAL_SEC=60
AGENT_PRIVATE_KEY=replace-with-a-valid-unfunded-private-key
# Production: prefer AGENT_PRIVATE_KEY_FILE=/run/secrets/guardian-agent-key.
# Set ALLOW_ENV_WALLET_KEYS=true only when using an encrypted deployment secret store.
ALLOW_ENV_WALLET_KEYS=false
CHAIN_ID=31337
ROUTER_ADDRESS=0x0000000000000000000000000000000000000001
MAX_POSITION_PCT=0.10
DAILY_LOSS_LIMIT_PCT=0.02
MAX_DRAWDOWN_PCT=0.15
LEVERAGE_CAP=3.0
MAX_VOL_PCT=0.05
VAR_LIMIT_PCT=0.03
