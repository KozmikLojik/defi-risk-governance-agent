{
  "scripts": {
    "contracts:compile": "hardhat compile --config contracts/hardhat.config.js",
    "contracts:test": "hardhat test --config contracts/hardhat.config.js",
    "contracts:check": "npm run contracts:compile && npm run contracts:test",
    "deploy:sepolia": "hardhat run contracts/scripts/deploy.js --config contracts/hardhat.config.js --network sepolia",
    "deploy:base-sepolia": "hardhat run contracts/scripts/deploy.js --config contracts/hardhat.config.js --network baseSepolia",
    "smoke:sepolia": "hardhat run contracts/scripts/smoke-test.js --config contracts/hardhat.config.js --network sepolia",
    "smoke:base-sepolia": "hardhat run contracts/scripts/smoke-test.js --config contracts/hardhat.config.js --network baseSepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.3.0",
    "dotenv": "^16.5.0",
    "hardhat": "^2.19.0"
  }
}
